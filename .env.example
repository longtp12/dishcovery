# Optional: URL of the deployed link-expander worker (see worker/README.md).
# Without it, short maps.app.goo.gl links fall back to searching the place name from the shared text.
VITE_LINK_EXPANDER_URL=

# Optional: Firebase web app config (Project settings → Your apps → Web app → SDK setup and configuration).
# With these set, people can sign in with Google and their places sync to Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Set to true to use the local emulators (npm run emulators) instead of the real project.
VITE_FIREBASE_EMULATORS=

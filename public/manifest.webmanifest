{
  "name": "Dishcovery",
  "short_name": "Dishcovery",
  "description": "Track restaurants you've visited and the ones on your wishlist.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EEE8FF",
  "theme_color": "#FFF4D6",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}

rules_version = '2';

// users/{uid}/places/{placeId}: each signed-in user's own places (only they can read/write).
// sharedPlaces/{id}: community places added from Google Maps links. Every signed-in user can read
//   and add them; only the person who added one can edit or delete it.
// lists/{listId}: shared lists. Members are invited by (verified) Google email; only the owner can
//   rename, change members or delete. lists/{listId}/places/{placeId}: any member can read and write;
//   each member's rating/review lives in its `reviews` map and only they can change their entry.
// Ratings/reviews on users/{uid}/places are private like the rest of your own places.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function optString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    // Name, location and the optional details every kind of place may carry.
    function validInfo(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && optString(d, 'osmId', 40)
        && optString(d, 'kind', 80)
        && optString(d, 'cuisine', 200)
        && optString(d, 'address', 300)
        && optString(d, 'openingHours', 300)
        && optString(d, 'googleUrl', 2000)
        && optString(d, 'googleId', 120)
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    function validPlace(d) {
      return d.keys().hasOnly([
          'name', 'lat', 'lng', 'osmId', 'kind', 'cuisine', 'address', 'openingHours', 'googleUrl', 'googleId',
          'sharedId', 'source', 'status', 'addedAt', 'visitedAt', 'updatedAt', 'rating', 'review', 'tags'
        ])
        && placeFields(d)
        && (!('rating' in d) || validRating(d.rating))
        && optString(d, 'review', 500);
    }

    function placeFields(d) {
      return d.keys().hasAll(['name', 'lat', 'lng', 'status', 'source', 'addedAt'])
        && validInfo(d)
        && d.status in ['wishlist', 'visited']
        && d.source in ['map', 'search', 'custom', 'google']
        && d.addedAt is number
        && (!('visitedAt' in d) || d.visitedAt is number)
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 12))
        && optString(d, 'sharedId', 64);
    }

    function validShared(d) {
      return d.keys().hasOnly([
          'name', 'lat', 'lng', 'osmId', 'kind', 'cuisine', 'address', 'openingHours', 'googleUrl', 'googleId',
          'addedBy', 'addedByName', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll(['name', 'lat', 'lng', 'googleUrl', 'addedBy', 'addedByName', 'createdAt'])
        && validInfo(d)
        && d.googleUrl.size() > 0
        && d.addedByName is string && d.addedByName.size() > 0 && d.addedByName.size() <= 100
        && d.createdAt is number;
    }

    function validRating(r) {
      return r is int && r >= 1 && r <= 5;
    }

    // One member's review in a list place's `reviews` map (keyed by uid).
    function validReview(r) {
      return r is map
        && r.keys().hasOnly(['rating', 'text', 'name', 'at'])
        && r.keys().hasAll(['rating', 'at'])
        && validRating(r.rating)
        && optString(r, 'text', 500)
        && optString(r, 'name', 100)
        && r.at is number;
    }

    // Members may only add, change or remove their own review.
    function reviewsOk(d, before) {
      let after = d.get('reviews', {});
      let changed = after.diff(before.get('reviews', {})).affectedKeys();
      return after is map && after.size() <= 60
        && changed.hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || validReview(after[request.auth.uid]));
    }

    // A list place: a place plus who added it, who visited it and who changed it last.
    function validListPlace(d) {
      return d.keys().hasOnly([
          'name', 'lat', 'lng', 'osmId', 'kind', 'cuisine', 'address', 'openingHours', 'googleUrl', 'googleId',
          'sharedId', 'source', 'status', 'addedAt', 'visitedAt', 'updatedAt',
          'addedBy', 'addedByName', 'visitedBy', 'visitedByName', 'updatedBy', 'reviews', 'tags'
        ])
        && placeFields(d)
        && d.keys().hasAll(['addedBy', 'addedByName', 'updatedBy'])
        && d.addedBy is string
        && d.addedByName is string && d.addedByName.size() <= 100
        && d.updatedBy == request.auth.uid
        && optString(d, 'visitedBy', 128)
        && optString(d, 'visitedByName', 100);
    }

    function validList(d) {
      return d.keys().hasOnly(['name', 'ownerUid', 'ownerName', 'memberEmails', 'memberUids', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'ownerUid', 'ownerName', 'memberEmails', 'memberUids', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.ownerName is string && d.ownerName.size() <= 100
        && d.memberEmails is list && d.memberEmails.size() <= 50
        && d.memberUids is list && d.memberUids.size() <= 60
        && d.createdAt is number
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    // The signed-in user's email, if Google has verified it (otherwise '', which matches no invite).
    function myEmail() {
      return request.auth.token.get('email_verified', false) == true ? request.auth.token.get('email', '') : '';
    }

    function isInvited(list) {
      return myEmail() != '' && myEmail() in list.memberEmails;
    }

    function isMember(list) {
      return signedIn() && (list.ownerUid == request.auth.uid || isInvited(list));
    }

    // users/{uid}: your own settings (just the theme for now), private to you.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['theme', 'updatedAt'])
        && optString(request.resource.data, 'theme', 30)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number);
    }

    match /users/{uid}/places/{placeId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && placeId.size() <= 64 && validPlace(request.resource.data);
    }

    match /sharedPlaces/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id.size() <= 64
        && validShared(request.resource.data)
        && request.resource.data.addedBy == request.auth.uid;
      // Only the adder; who added it and when can't change.
      allow update: if signedIn() && resource.data.addedBy == request.auth.uid
        && validShared(request.resource.data)
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.addedBy == request.auth.uid;
    }

    match /lists/{listId} {
      allow read: if isMember(resource.data);
      allow create: if signedIn()
        && validList(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if signedIn()
        && validList(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.ownerUid == request.auth.uid || joining() || leaving());
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // An invited user adds just their own uid.
      function joining() {
        return isInvited(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          && request.resource.data.memberUids.toSet()
            == resource.data.memberUids.toSet().union([request.auth.uid].toSet());
      }

      // A member removes just their own email and uid.
      function leaving() {
        return isInvited(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberEmails', 'memberUids', 'updatedAt'])
          && request.resource.data.memberEmails.toSet()
            == resource.data.memberEmails.toSet().difference([myEmail()].toSet())
          && request.resource.data.memberUids.toSet()
            == resource.data.memberUids.toSet().difference([request.auth.uid].toSet());
      }

      match /places/{placeId} {
        function theList() {
          return get(/databases/$(database)/documents/lists/$(listId)).data;
        }

        allow read, delete: if isMember(theList());
        allow create: if isMember(theList()) && placeId.size() <= 64
          && validListPlace(request.resource.data)
          && request.resource.data.addedBy == request.auth.uid
          && (!('visitedBy' in request.resource.data) || request.resource.data.visitedBy == request.auth.uid)
          && reviewsOk(request.resource.data, {});
        // Who added it (and when) stays; "visited by" can only become you, stay, or be cleared.
        allow update: if isMember(theList())
          && validListPlace(request.resource.data)
          && request.resource.data.addedBy == resource.data.addedBy
          && request.resource.data.addedByName == resource.data.addedByName
          && request.resource.data.addedAt == resource.data.addedAt
          && (!('visitedBy' in request.resource.data)
            || request.resource.data.visitedBy == resource.data.get('visitedBy', null)
            || request.resource.data.visitedBy == request.auth.uid)
          && reviewsOk(request.resource.data, resource.data);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
